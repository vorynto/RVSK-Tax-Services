# Public site URL used for canonical URLs, sitemap and structured data (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://rvsktaxservices.com

# Contact form email delivery via Resend (https://resend.com) — server-side only
RESEND_API_KEY=
# Inbox that receives enquiries (comma-separate multiple addresses)
CONTACT_TO_EMAIL=customersupport@rvsktaxservices.com
# Sender on a domain verified in Resend
CONTACT_FROM_EMAIL="RVSK Website <website@rvsktaxservices.com>"
